{
  "schema": 1,
  "id": "valet-devin",
  "name": "Devin CLI",
  "version": "0.1.0",
  "description": "inference@1 agent provider devin-cli over devin acp.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["inference@1", "settings@2"],
  "optionalRequires": ["transport@1"],
  "settings": {
    "sections": {
      "inference": {
        "subsections": [
          {
            "id": "behaviour",
            "label": "Behaviour",
            "items": [
              {
                "id": "permissionMode",
                "label": "Permission mode",
                "summary": "Sent as modeId to session/set_mode when a session opens.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "normal",
                      "label": "Normal"
                    },
                    {
                      "value": "accept-edits",
                      "label": "Accept edits"
                    },
                    {
                      "value": "smart",
                      "label": "Smart"
                    },
                    {
                      "value": "plan",
                      "label": "Plan"
                    },
                    {
                      "value": "bypass",
                      "label": "Bypass permissions"
                    }
                  ],
                  "default": "accept-edits"
                }
              },
              {
                "id": "utilityModel",
                "label": "Utility model",
                "summary": "Model for small side jobs such as naming sessions; may end in an effort (claude-haiku-5-5-low). Empty turns them off.",
                "input": {
                  "type": "string",
                  "default": "claude-haiku-5-5"
                }
              }
            ]
          },
          {
            "id": "models",
            "label": "Models",
            "items": [
              {
                "id": "hideFusion",
                "label": "Hide Fusion models",
                "summary": "Hides the fusion-* model variants from the model list.",
                "input": {
                  "type": "bool",
                  "default": true
                }
              },
              {
                "id": "hideAdaptive",
                "label": "Hide Adaptive",
                "summary": "Hides the adaptive model from the model list.",
                "input": {
                  "type": "bool",
                  "default": true
                }
              }
            ]
          },
          {
            "id": "tools",
            "label": "Tools",
            "items": [
              {
                "id": "denyKinds",
                "label": "Denied ACP kinds",
                "summary": "ACP tool kinds Devin may never run when it asks permission, e.g. execute.",
                "input": {
                  "type": "tags"
                },
                "advanced": true
              }
            ]
          },
          {
            "id": "runtime",
            "label": "Runtime",
            "items": [
              {
                "id": "command",
                "label": "ACP command",
                "summary": "Command used to start the Devin ACP child. Default: devin acp. Needs a valet restart.",
                "input": {
                  "type": "tags"
                },
                "advanced": true
              },
              {
                "id": "refusalFallback",
                "label": "Refusal fallbacks",
                "summary": "Models passed as --refusal-fallback when the ACP child starts. Needs a valet restart.",
                "input": {
                  "type": "tags"
                },
                "advanced": true
              },
              {
                "id": "models",
                "label": "Model list",
                "summary": "Replaces the live devin models list. Rename or hide models on the Models page instead.",
                "input": {
                  "type": "list",
                  "item": {
                    "type": "group",
                    "inputs": [
                      {
                        "id": "id",
                        "type": "string",
                        "label": "Model id",
                        "required": true
                      },
                      {
                        "id": "name",
                        "type": "string",
                        "label": "Name"
                      },
                      {
                        "id": "contextWindow",
                        "type": "number",
                        "label": "Context window"
                      },
                      {
                        "id": "maxOutputTokens",
                        "type": "number",
                        "label": "Max output"
                      },
                      {
                        "id": "efforts",
                        "type": "multiselect",
                        "options": [
                          {
                            "value": "none"
                          },
                          {
                            "value": "minimal"
                          },
                          {
                            "value": "low"
                          },
                          {
                            "value": "medium"
                          },
                          {
                            "value": "high"
                          },
                          {
                            "value": "xhigh"
                          },
                          {
                            "value": "max"
                          }
                        ],
                        "label": "Efforts"
                      },
                      {
                        "id": "defaultEffort",
                        "type": "select",
                        "options": [
                          {
                            "value": "none"
                          },
                          {
                            "value": "minimal"
                          },
                          {
                            "value": "low"
                          },
                          {
                            "value": "medium"
                          },
                          {
                            "value": "high"
                          },
                          {
                            "value": "xhigh"
                          },
                          {
                            "value": "max"
                          }
                        ],
                        "label": "Default effort"
                      },
                      {
                        "id": "fast",
                        "type": "bool",
                        "label": "Fast mode"
                      }
                    ]
                  }
                },
                "advanced": true
              }
            ]
          }
        ],
        "icon": "devin"
      }
    }
  }
}
